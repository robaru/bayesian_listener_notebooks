# Input data are downloaded by init.sh (or obtained from the SONICOM data
# ecosystem) and are not committed -- except the KEMAR HRTF used for
# Figs. 1-3 and S1 and notebooks 02-04, and the list of the 33 target directions.
/data/**
!/data/hrtf/
!/data/hrtf/KEMAR_FreeFieldCompMinPhase_48kHz.sofa
!/data/target_directions.csv

# Generated figures (python -m figures.generate_all)
/figures/output/

# Rendered R report
/R/*.html
/R/*.pdf
/R/fitting_analysis_files/
